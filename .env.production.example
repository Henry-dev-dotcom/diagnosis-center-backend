# Production environment template. Copy to .env on the server and replace every
# <placeholder>. Never commit real values. Mirrors the keys set in render.yaml.
NODE_ENV=production
PORT=5000
API_PREFIX=/api
FRONTEND_URL=https://<your-frontend-domain>
FRONTEND_URLS=https://<your-frontend-domain>
# Use the provider's pooled endpoint for runtime traffic. Keep the pool small
# per instance because each load-balanced instance owns its own pool.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public&connection_limit=5&pool_timeout=10"
# The unpooled address, which Prisma uses for migrations. On Neon this is the
# same connection string without "-pooler" in the host name.
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public"
# At least 32 random characters each, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Use none when the frontend is on a different site from the API (requires HTTPS).
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=.example.com
TRUST_PROXY=true
# Leave LOG_LEVEL unset in production: the access log then records method +
# path only, never the query string (signed download links travel in query
# strings). Set it explicitly only if you accept that trade-off.
# LOG_LEVEL=combined
ENABLE_API_DOCS=false
BODY_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
UPLOAD_STORAGE_DRIVER=local
UPLOAD_ROOT=uploads
MAX_UPLOAD_BYTES=26214400
SIGNED_FILE_URL_TTL_MINUTES=15
# Optional comma-separated replacement for the built-in upload MIME allowlist.
# UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf,application/dicom
DICOM_GATEWAY_MODE=metadata-only
# Transactional email (verification links). Off by default in production; set
# MAIL_DRIVER=resend with a key to start sending. Without email, verification
# links cannot be delivered, so configure this before announcing the feature.
# MAIL_DRIVER=resend
# RESEND_API_KEY=<resend-api-key>
# MAIL_FROM="LHIMS <no-reply@your-domain>"
# Where the web app is served from, including any path (GitHub Pages serves a
# project under /<repo>). Emailed links point here; FRONTEND_URL is origin only.
# FRONTEND_APP_URL=https://<user>.github.io/<repo>
# Platform operator created by `npm run seed:production` on an empty database.
# It signs in with no facility code and creates each facility and its first admin.
SEED_ADMIN_USERNAME=platform
SEED_ADMIN_EMAIL=<operator-email>
SEED_ADMIN_PASSWORD=<strong-initial-password-at-least-12-chars>

# Subscriptions (Phase 5). Without a Paystack key, online payment is switched
# off and every facility stays platform-managed (departments set by hand).
# Use the Paystack LIVE secret key here; set the webhook URL in the Paystack
# dashboard to https://<api-host>/api/billing/webhooks/paystack
# PAYMENT_GATEWAY=paystack
# PAYSTACK_SECRET_KEY=<paystack-secret-key>
# PAYMENT_CALLBACK_URL=https://<frontend-host>/
BILLING_GRACE_DAYS=7

# Operations (Phase 7): incoming-webhook URL for errors and billing failures.
# ALERT_WEBHOOK_URL=<slack-or-teams-webhook-url>
