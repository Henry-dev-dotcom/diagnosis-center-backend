NODE_ENV=development
PORT=5000
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diagnosis_center?schema=public"
# Prisma runs migrations over this one. With a local Postgres there is no
# connection pooler, so it is the same address as DATABASE_URL. On a hosted
# Postgres such as Neon, use that provider's DIRECT (unpooled) address here.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/diagnosis_center?schema=public"
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Auth cookies (httpOnly). For cross-site frontend (e.g. GitHub Pages) set
# AUTH_COOKIE_SAMESITE=none (forces Secure on, requires HTTPS on both ends).
# AUTH_COOKIE_SECURE defaults to true in production. Set AUTH_COOKIE_DOMAIN only
# if the API and frontend share a parent domain.
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=.example.com
# Stricter limiter for /auth/login and /auth/refresh (brute-force protection)
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
# Unset LOG_LEVEL in production: the access log then records method + path only,
# never the query string (signed download links travel in query strings).
LOG_LEVEL=dev
TRUST_PROXY=false
# API docs default on in development, off in production. Set explicitly to override.
ENABLE_API_DOCS=true
BODY_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240
UPLOAD_STORAGE_DRIVER=local
UPLOAD_ROOT=uploads
MAX_UPLOAD_BYTES=26214400
SIGNED_FILE_URL_TTL_MINUTES=15
# Optional comma-separated replacement for the built-in upload MIME allowlist
# (see DEFAULT_ALLOWED_MIME_TYPES in src/services/fileStorage.service.ts).
# UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf,application/dicom
DICOM_GATEWAY_MODE=metadata-only
# Transactional email (verification links). 'log' prints to the server log
# (development default), 'resend' sends through Resend, 'disabled' (production
# default) sends nothing until configured.
MAIL_DRIVER=log
# RESEND_API_KEY=re_xxx
MAIL_FROM="LHIMS <no-reply@lhims.app>"
# Absolute public base of this API, used to build links sent by email. When
# unset, links are built from the host of the incoming request.
# API_PUBLIC_URL=https://api.example.com/api
# Integration tests (npm run test:integration) wipe and rebuild this database.
# Its name must contain "test".
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diagnosis_center_test?schema=public"

# Subscriptions (Phase 5). In development the "fake" gateway is used unless a
# Paystack key is set: checkout links open a local test-payment page.
# PAYMENT_GATEWAY=fake
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYMENT_CALLBACK_URL=http://localhost:5173/
BILLING_GRACE_DAYS=7

# Operations (Phase 7)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   # errors and billing failures
# PG_BIN="C:\Program Files\PostgreSQL\13\bin"               # for npm run db:backup / db:restore-check
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# ACCESS_CACHE_TTL_MS=5000   # departments/subscription state cache per facility (0 = off)
