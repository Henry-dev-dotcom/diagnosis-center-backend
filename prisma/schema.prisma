  @@index([facilityId])
  @@index([reportId])
  @@index([notificationId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model SecureResultLink {
  id           String    @id @default(cuid())
  facilityId   String    @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  reportId     String
  patientId    String?
  createdById  String?
  tokenHash    String    @unique
  passwordHash String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  report    Report   @relation(fields: [reportId], references: [id])
  patient   Patient? @relation(fields: [patientId], references: [id])
  createdBy User?    @relation("SecureLinkCreatedBy", fields: [createdById], references: [id])

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@index([reportId])
  @@index([expiresAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  facilityId String?
  actorId    String?
  actorRole  UserRole?
  action     String
  module     String
  entityType String?
  entityId   String?
  beforeData Json?
  afterData  Json?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId])
  @@index([module])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemEvent {
  id         String   @id @default(cuid())
  facilityId String?
  actorId    String?
  level      String   @default("info")
  source     String
  message    String
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation("SystemEventActor", fields: [actorId], references: [id])

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

model ApiRequestLog {
  id         String   @id @default(cuid())
  facilityId String?
  userId     String?
  requestId  String?
  method     String
  path       String
  statusCode Int?
  durationMs Int?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation("ApiRequestUser", fields: [userId], references: [id])

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId])
  @@index([userId])
  @@index([path])
  @@index([statusCode])
  @@index([createdAt])
}

/// A department module a facility has switched on (see src/config/modules.ts).
/// A missing row means the module is off.
model FacilityModule {
  id         String   @id @default(cuid())
  facilityId String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  moduleKey  String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, moduleKey])
  @@index([facilityId])
}

/// A staff role a facility defines on top of a base workspace role.
model FacilityRole {
  id          String   @id @default(cuid())
  facilityId  String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  name        String
  description String?
  /// Fixed at creation; users assigned this role take it as their User.role.
  baseRole    UserRole
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id])
  users    User[]

  @@unique([facilityId, name])
  @@index([facilityId])
}

// ---------------------------------------------------------------------------
// Phase 3: clinical backbone. An Encounter is one visit; everything clinical
// (vitals, notes, diagnoses, prescriptions, orders, charges) hangs off it.
// ---------------------------------------------------------------------------

enum EncounterType {
  OPD
  EMERGENCY
  INPATIENT
}

enum EncounterStatus {
  WAITING_TRIAGE
  WAITING_DOCTOR
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

/// South African Triage Scale colours, as used in Ghanaian emergency care.
enum TriageLevel {
  RED
  ORANGE
  YELLOW
  GREEN
}

enum ClinicalNoteType {
  TRIAGE
  CONSULTATION
  PROGRESS
  DISCHARGE
  NURSING
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  PROVISIONAL
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum PrescriptionStatus {
  ACTIVE
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

model Encounter {
  id                    String          @id @default(cuid())
  facilityId            String          @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  encounterCode         String
  patientId             String
  visitId               String?
  type                  EncounterType   @default(OPD)
  status                EncounterStatus @default(WAITING_TRIAGE)
  triageLevel           TriageLevel?
  chiefComplaint        String?
  attendingId           String?
  createdById           String?
  startedAt             DateTime        @default(now())
  triagedAt             DateTime?
  consultationStartedAt DateTime?
  completedAt           DateTime?
  /// DISCHARGED, REFERRED, ADMITTED, LEFT_WITHOUT_BEING_SEEN, ... (free text for now)
  outcome               String?
  cancelReason          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  facility          Facility       @relation(fields: [facilityId], references: [id])
  patient           Patient        @relation(fields: [patientId], references: [id])
  visit             PatientVisit?  @relation(fields: [visitId], references: [id])
  attending         User?          @relation("EncounterAttending", fields: [attendingId], references: [id])
  createdBy         User?          @relation("EncounterCreatedBy", fields: [createdById], references: [id])
  vitalSigns        VitalSigns[]
  notes             ClinicalNote[]
  diagnoses         Diagnosis[]
  prescriptions     Prescription[]
  orders            Order[]
  invoices          Invoice[]
  /// The admission this inpatient encounter belongs to.
  admission         Admission?     @relation("AdmissionEncounter")
  /// Admissions that started from this (OPD/emergency) visit.
  admissionsStarted Admission[]    @relation("AdmissionSource")

  @@unique([facilityId, encounterCode])
  @@index([facilityId])
  @@index([patientId])
  @@index([status])
  @@index([startedAt])
}

model VitalSigns {
  id              String   @id @default(cuid())
  facilityId      String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  encounterId     String
  patientId       String
  recordedById    String?
  temperatureC    Decimal? @db.Decimal(4, 1)
  pulseBpm        Int?
  respiratoryRate Int?
  systolicBp      Int?
  diastolicBp     Int?
  spo2            Int?
  weightKg        Decimal? @db.Decimal(5, 1)
  heightCm        Decimal? @db.Decimal(5, 1)
  painScore       Int?
  /// mmol/L
  bloodGlucose    Decimal? @db.Decimal(5, 1)
  notes           String?
  recordedAt      DateTime @default(now())

  facility   Facility  @relation(fields: [facilityId], references: [id])
  encounter  Encounter @relation(fields: [encounterId], references: [id])
  patient    Patient   @relation(fields: [patientId], references: [id])
  recordedBy User?     @relation("VitalsRecordedBy", fields: [recordedById], references: [id])

  @@index([facilityId])
  @@index([encounterId])
  @@index([patientId, recordedAt])
}

/// Append-only: a correction is a new note that points at the one it amends.
model ClinicalNote {
  id          String           @id @default(cuid())
  facilityId  String           @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  encounterId String
  patientId   String
  authorId    String?
  type        ClinicalNoteType
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  amendsId    String?
  createdAt   DateTime         @default(now())

  facility  Facility       @relation(fields: [facilityId], references: [id])
  encounter Encounter      @relation(fields: [encounterId], references: [id])
  patient   Patient        @relation(fields: [patientId], references: [id])
  author    User?          @relation("NoteAuthor", fields: [authorId], references: [id])
  amends    ClinicalNote?  @relation("NoteAmendment", fields: [amendsId], references: [id])
  amendedBy ClinicalNote[] @relation("NoteAmendment")

  @@index([facilityId])
  @@index([encounterId])
}

model Diagnosis {
  id           String          @id @default(cuid())
  facilityId   String          @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  encounterId  String
  patientId    String
  recordedById String?
  /// ICD-10 code when known; description is always required.
  code         String?
  description  String
  type         DiagnosisType   @default(PRIMARY)
  status       DiagnosisStatus @default(ACTIVE)
  /// Chronic, active diagnoses form the patient's problem list.
  isChronic    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  resolvedAt   DateTime?

  facility   Facility  @relation(fields: [facilityId], references: [id])
  encounter  Encounter @relation(fields: [encounterId], references: [id])
  patient    Patient   @relation(fields: [patientId], references: [id])
  recordedBy User?     @relation("DiagnosisRecordedBy", fields: [recordedById], references: [id])

  @@index([facilityId])
  @@index([encounterId])
  @@index([patientId, status])
}

model PatientAllergy {
  id           String          @id @default(cuid())
  facilityId   String          @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  patientId    String
  recordedById String?
  substance    String
  reaction     String?
  severity     AllergySeverity @default(MODERATE)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  facility   Facility @relation(fields: [facilityId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id])
  recordedBy User?    @relation("AllergyRecordedBy", fields: [recordedById], references: [id])

  @@index([facilityId])
  @@index([patientId])
}

model Prescription {
  id               String             @id @default(cuid())
  facilityId       String             @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  prescriptionCode String
  encounterId      String
  patientId        String
  prescriberId     String?
  status           PrescriptionStatus @default(ACTIVE)
  notes            String?
  cancelReason     String?
  /// Why the prescriber went ahead despite a recorded allergy.
  allergyOverride  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  facility      Facility           @relation(fields: [facilityId], references: [id])
  encounter     Encounter          @relation(fields: [encounterId], references: [id])
  patient       Patient            @relation(fields: [patientId], references: [id])
  prescriber    User?              @relation("Prescriber", fields: [prescriberId], references: [id])
  items         PrescriptionItem[]
  dispensations Dispensation[]

  @@unique([facilityId, prescriptionCode])
  @@index([facilityId])
  @@index([encounterId])
  @@index([patientId])
}

/// Free-text drug lines until the Phase 4 pharmacy adds a drug catalogue.
model PrescriptionItem {
  id             String  @id @default(cuid())
  facilityId     String  @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  prescriptionId String
  drugName       String
  strength       String?
  dosageForm     String?
  dose           String
  route          String
  frequency      String
  durationDays   Int?
  quantity       Int?
  instructions   String?

  facility          Facility                   @relation(fields: [facilityId], references: [id])
  prescription      Prescription               @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  /// The formulary drug, when the prescriber picked one; free-text lines are matched at dispensing.
  drugId            String?
  quantityDispensed Int                        @default(0)
  drug              Drug?                      @relation(fields: [drugId], references: [id])
  dispensedLines    DispensationItem[]
  administrations   MedicationAdministration[]

  @@index([facilityId])
  @@index([prescriptionId])
}

// ---------------------------------------------------------------------------
// Phase 4A: pharmacy. Stock is held in batches; every change is a StockMovement.
// Dispensing takes from the batches that expire first (FEFO).
// ---------------------------------------------------------------------------

enum StockMovementType {
  RECEIPT
  DISPENSE
  ADJUSTMENT
  EXPIRY_WRITE_OFF
}

model Drug {
  id           String   @id @default(cuid())
  facilityId   String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  drugCode     String
  genericName  String
  brandName    String?
  strength     String?
  dosageForm   String?
  /// The unit stock is counted and sold in (tablet, capsule, bottle, vial...).
  unit         String   @default("unit")
  unitPrice    Decimal  @default(0) @db.Decimal(10, 2)
  reorderLevel Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facility          Facility           @relation(fields: [facilityId], references: [id])
  batches           DrugBatch[]
  movements         StockMovement[]
  prescriptionItems PrescriptionItem[]
  dispensedLines    DispensationItem[]

  @@unique([facilityId, drugCode])
  @@index([facilityId])
  @@index([genericName])
}

model DrugBatch {
  id               String   @id @default(cuid())
  facilityId       String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  drugId           String
  batchNumber      String
  expiryDate       DateTime
  quantityReceived Int
  quantityOnHand   Int
  costPrice        Decimal? @db.Decimal(10, 2)
  supplier         String?
  receivedById     String?
  receivedAt       DateTime @default(now())

  facility   Facility        @relation(fields: [facilityId], references: [id])
  drug       Drug            @relation(fields: [drugId], references: [id])
  receivedBy User?           @relation("BatchReceivedBy", fields: [receivedById], references: [id])
  movements  StockMovement[]

  @@unique([facilityId, drugId, batchNumber])
  @@index([facilityId])
  @@index([drugId, expiryDate])
}

/// Append-only stock ledger. quantity is positive for stock in, negative for stock out.
model StockMovement {
  id                 String            @id @default(cuid())
  facilityId         String            @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  drugId             String
  batchId            String?
  type               StockMovementType
  quantity           Int
  reason             String?
  dispensationItemId String?
  actorId            String?
  createdAt          DateTime          @default(now())

  facility         Facility          @relation(fields: [facilityId], references: [id])
  drug             Drug              @relation(fields: [drugId], references: [id])
  batch            DrugBatch?        @relation(fields: [batchId], references: [id])
  dispensationItem DispensationItem? @relation(fields: [dispensationItemId], references: [id])
  actor            User?             @relation("StockMovedBy", fields: [actorId], references: [id])

  @@index([facilityId])
  @@index([drugId, createdAt])
}

model Dispensation {
  id               String   @id @default(cuid())
  facilityId       String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  dispensationCode String
  prescriptionId   String
  dispensedById    String?
  invoiceId        String?  @unique
  notes            String?
  /// Set when the pharmacist dispensed despite a recorded allergy.
  allergyOverride  String?
  dispensedAt      DateTime @default(now())

  facility     Facility           @relation(fields: [facilityId], references: [id])
  prescription Prescription       @relation(fields: [prescriptionId], references: [id])
  dispensedBy  User?              @relation("DispensedBy", fields: [dispensedById], references: [id])
  invoice      Invoice?           @relation(fields: [invoiceId], references: [id])
  items        DispensationItem[]

  @@unique([facilityId, dispensationCode])
  @@index([facilityId])
  @@index([prescriptionId])
}

model DispensationItem {
  id                 String  @id @default(cuid())
  facilityId         String  @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  dispensationId     String
  prescriptionItemId String
  drugId             String
  quantity           Int
  unitPrice          Decimal @db.Decimal(10, 2)

  facility         Facility         @relation(fields: [facilityId], references: [id])
  dispensation     Dispensation     @relation(fields: [dispensationId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  drug             Drug             @relation(fields: [drugId], references: [id])
  movements        StockMovement[]

  @@index([facilityId])
  @@index([dispensationId])
}

/// Per-facility counters for human-readable codes (PAT-0001, ORD-2026-0001, ...).
/// Incremented with a row lock (src/services/codeSequence.service.ts) so
/// simultaneous requests never receive the same code.
model FacilitySequence {
  facilityId String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  /// The code prefix this counter serves, e.g. "PAT-" or "ORD-2026-".
  name       String
  value      Int
  updatedAt  DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id])

  @@id([facilityId, name])
}

// ---------------------------------------------------------------------------
// Phase 4B: inpatient care. An Admission owns an INPATIENT encounter, so the
// usual notes, vitals, diagnoses, orders and prescriptions apply to it.
// ---------------------------------------------------------------------------

enum WardType {
  GENERAL
  MEDICAL
  SURGICAL
  MATERNITY
  PAEDIATRIC
  ICU
  PRIVATE
}

enum WardGender {
  MALE
  FEMALE
  MIXED
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  OUT_OF_SERVICE
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  CANCELLED
}

enum AdministrationStatus {
  GIVEN
  HELD
  REFUSED
  MISSED
}

model Ward {
  id         String     @id @default(cuid())
  facilityId String     @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  code       String
  name       String
  type       WardType   @default(GENERAL)
  gender     WardGender @default(MIXED)
  /// Charged per night at discharge when Billing is on.
  dailyRate  Decimal    @default(0) @db.Decimal(10, 2)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  facility       Facility        @relation(fields: [facilityId], references: [id])
  beds           Bed[]
  admissions     Admission[]
  bedAssignments BedAssignment[]

  @@unique([facilityId, code])
  @@index([facilityId])
}

model Bed {
  id         String    @id @default(cuid())
  facilityId String    @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  wardId     String
  label      String
  status     BedStatus @default(AVAILABLE)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  facility       Facility        @relation(fields: [facilityId], references: [id])
  ward           Ward            @relation(fields: [wardId], references: [id])
  admissions     Admission[]
  bedAssignments BedAssignment[]

  @@unique([facilityId, wardId, label])
  @@index([facilityId])
  @@index([wardId])
}

model Admission {
  id                  String          @id @default(cuid())
  facilityId          String          @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  admissionCode       String
  patientId           String
  /// The inpatient encounter holding this stay's clinical record.
  encounterId         String          @unique
  /// The OPD or emergency visit the patient was admitted from, if any.
  sourceEncounterId   String?
  wardId              String
  bedId               String
  status              AdmissionStatus @default(ADMITTED)
  reason              String
  admittedById        String?
  attendingId         String?
  admittedAt          DateTime        @default(now())
  expectedDischargeAt DateTime?
  dischargedAt        DateTime?
  dischargedById      String?
  dischargeOutcome    String?
  dischargeSummary    String?
  cancelReason        String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  facility        Facility                   @relation(fields: [facilityId], references: [id])
  patient         Patient                    @relation(fields: [patientId], references: [id])
  encounter       Encounter                  @relation("AdmissionEncounter", fields: [encounterId], references: [id])
  sourceEncounter Encounter?                 @relation("AdmissionSource", fields: [sourceEncounterId], references: [id])
  ward            Ward                       @relation(fields: [wardId], references: [id])
  bed             Bed                        @relation(fields: [bedId], references: [id])
  admittedBy      User?                      @relation("AdmittedBy", fields: [admittedById], references: [id])
  attending       User?                      @relation("AdmissionAttending", fields: [attendingId], references: [id])
  dischargedBy    User?                      @relation("DischargedBy", fields: [dischargedById], references: [id])
  bedAssignments  BedAssignment[]
  administrations MedicationAdministration[]

  @@unique([facilityId, admissionCode])
  @@index([facilityId])
  @@index([status])
  @@index([wardId, status])
}

/// Where the patient was, and when: one row per bed occupied during the stay.
model BedAssignment {
  id           String    @id @default(cuid())
  facilityId   String    @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  admissionId  String
  wardId       String
  bedId        String
  assignedById String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  reason       String?

  facility   Facility  @relation(fields: [facilityId], references: [id])
  admission  Admission @relation(fields: [admissionId], references: [id])
  ward       Ward      @relation(fields: [wardId], references: [id])
  bed        Bed       @relation(fields: [bedId], references: [id])
  assignedBy User?     @relation("BedAssignedBy", fields: [assignedById], references: [id])

  @@index([facilityId])
  @@index([admissionId])
}

/// The medication administration record (MAR): each dose given, held, refused or missed.
model MedicationAdministration {
  id                 String               @id @default(cuid())
  facilityId         String               @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  admissionId        String
  prescriptionItemId String
  status             AdministrationStatus
  doseGiven          String?
  notes              String?
  administeredById   String?
  administeredAt     DateTime             @default(now())

  facility         Facility         @relation(fields: [facilityId], references: [id])
  admission        Admission        @relation(fields: [admissionId], references: [id])
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  administeredBy   User?            @relation("AdministeredBy", fields: [administeredById], references: [id])

  @@index([facilityId])
  @@index([admissionId, administeredAt])
}
