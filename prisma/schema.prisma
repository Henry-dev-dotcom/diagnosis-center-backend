generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations cannot run through a connection pooler: they take advisory locks
  // and issue DDL that pgbouncer in transaction mode will not carry. A hosted
  // Postgres such as Neon gives two addresses - a pooled one for the running app
  // and a direct one - and this is the direct one. Where there is no pooler, set
  // it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// What a customer actually runs, which is what they choose on the pricing page
// before they ever see a price. A diagnostic centre is not a small hospital: it
// needs a different set of departments, not fewer of the same ones.
enum FacilityKind {
  DIAGNOSTIC_CENTRE
  PHARMACY
  CLINIC
  HOSPITAL
}

enum FacilityStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

/// A tenant: one hospital, clinic or diagnostic centre that subscribes to LHIMS.
/// Every tenant-owned row carries facilityId; see src/services/tenantContext.ts.
/// Not to be confused with Hospital, which models referring hospitals.
model Facility {
  id                      String         @id @default(cuid())
  code                    String         @unique
  name                    String
  status                  FacilityStatus @default(ACTIVE)
  phone                   String?
  email                   String?
  address                 String?
  timezone                String         @default("Africa/Accra")
  currency                String         @default("GHS")
  /// Small logo shown in the app header (a PNG/JPEG/WebP data URL, at most ~200 KB).
  logoDataUrl             String?
  /// SELF_SERVICE (signed up on the website) or PLATFORM (created by the operator).
  signupSource            String         @default("PLATFORM")
  /// Set when the administrator finishes (or skips) the setup checklist.
  onboardingCompletedAt   DateTime?
  /// Whether LHIMS support may open a read-only support session in this facility.
  allowSupportAccess      Boolean        @default(true)
  /// Whether a clinician's order waits for reception to confirm and route it
  /// before the laboratory or scan unit can see it. True for a diagnostic
  /// centre, whose work arrives from clinicians elsewhere and has to be received;
  /// false in a hospital or clinic, where the clinician and the lab are the same
  /// building and a receptionist in between only delays the sample.
  receptionConfirmsOrders Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  staffMessages             StaffMessage[]
  modules                   FacilityModule[]
  sequences                 FacilitySequence[]
  facilityRoles             FacilityRole[]
  users                     User[]
  hospitals                 Hospital[]
  doctorProfiles            DoctorProfile[]
  patients                  Patient[]
  patientContacts           PatientContact[]
  patientInsurances         PatientInsurance[]
  patientDuplicateFlags     PatientDuplicateFlag[]
  departments               Department[]
  equipments                Equipment[]
  catalogItems              CatalogItem[]
  referenceParameters       ReferenceParameter[]
  referenceRanges           ReferenceRange[]
  orders                    Order[]
  orderItems                OrderItem[]
  orderStatusHistorys       OrderStatusHistory[]
  orderCancellations        OrderCancellation[]
  appointments              Appointment[]
  patientVisits             PatientVisit[]
  labSamples                LabSample[]
  labResults                LabResult[]
  labResultParameters       LabResultParameter[]
  labResultReviews          LabResultReview[]
  labResultAmendments       LabResultAmendment[]
  analyzerDevices           AnalyzerDevice[]
  analyzerTestMaps          AnalyzerTestMap[]
  analyzerMessages          AnalyzerMessage[]
  sampleRejections          SampleRejection[]
  qualityControlRuns        QualityControlRun[]
  inventoryItems            InventoryItem[]
  inventoryTransactions     InventoryTransaction[]
  scanAcceptances           ScanAcceptance[]
  scanBookings              ScanBooking[]
  scanResults               ScanResult[]
  scanResultFiles           ScanResultFile[]
  scanReviews               ScanReview[]
  scanRetakes               ScanRetake[]
  invoices                  Invoice[]
  invoiceItems              InvoiceItem[]
  payments                  Payment[]
  cashierShifts             CashierShift[]
  floatTransactions         FloatTransaction[]
  expenses                  Expense[]
  expensePayments           ExpensePayment[]
  ledgerEntrys              LedgerEntry[]
  receipts                  Receipt[]
  reports                   Report[]
  notifications             Notification[]
  deliveryLogs              DeliveryLog[]
  secureResultLinks         SecureResultLink[]
  auditLogs                 AuditLog[]
  systemEvents              SystemEvent[]
  apiRequestLogs            ApiRequestLog[]
  encounters                Encounter[]
  vitalSigns                VitalSigns[]
  clinicalNotes             ClinicalNote[]
  diagnoses                 Diagnosis[]
  patientAllergies          PatientAllergy[]
  prescriptions             Prescription[]
  prescriptionItems         PrescriptionItem[]
  drugs                     Drug[]
  drugBatches               DrugBatch[]
  stockMovements            StockMovement[]
  dispensations             Dispensation[]
  dispensationItems         DispensationItem[]
  wards                     Ward[]
  beds                      Bed[]
  admissions                Admission[]
  bedAssignments            BedAssignment[]
  medicationAdministrations MedicationAdministration[]
  theatres                  Theatre[]
  clinicalForms             ClinicalForm[]
  pregnancies               Pregnancy[]
  deliveries                Delivery[]
  newborns                  Newborn[]
  immunizations             Immunization[]
  insuranceSchemes          InsuranceScheme[]
  claims                    Claim[]
  claimLines                ClaimLine[]
  claimBatches              ClaimBatch[]
  suppliers                 Supplier[]
  storeItems                StoreItem[]
  purchaseOrders            PurchaseOrder[]
  purchaseOrderLines        PurchaseOrderLine[]
  goodsReceipts             GoodsReceipt[]
  goodsReceiptLines         GoodsReceiptLine[]
  requisitions              Requisition[]
  requisitionLines          RequisitionLine[]
  storeMovements            StoreMovement[]
  bloodDonors               BloodDonor[]
  bloodDonations            BloodDonation[]
  bloodUnits                BloodUnit[]
  bloodRequests             BloodRequest[]
  crossmatches              Crossmatch[]
  transfusions              Transfusion[]
  mortuarySlots             MortuarySlot[]
  deceasedRecords           DeceasedRecord[]
  staffProfiles             StaffProfile[]
  shiftTypes                ShiftType[]
  rotaEntries               RotaEntry[]
  leaveRequests             LeaveRequest[]
  chartAccesses             ChartAccess[]
  recordRequests            RecordRequest[]
  subscription              Subscription?
  subscriptionInvoices      SubscriptionInvoice[]
  surgeries                 Surgery[]
  ScanResultAmendment       ScanResultAmendment[]

  @@index([status])
}

