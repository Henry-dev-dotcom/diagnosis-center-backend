/// How an analyzer talks to us. See docs/ANALYZER_INTERFACING.md.
enum AnalyzerProtocol {
  /// HL7 v2 ORU^R01 observation messages: most modern analyzers and middleware.
  HL7_V2
  /// ASTM E1381/E1394 records, which older serial analyzers still speak.
  ASTM
  /// A delimited export file the analyzer writes to disk.
  CSV
  /// Our own JSON shape, for a custom or in-house integration.
  JSON
}

enum AnalyzerDeviceStatus {
  ACTIVE
  DISABLED
}

enum AnalyzerMessageStatus {
  /// Stored exactly as it arrived; not processed yet.
  RECEIVED
  /// Every observation in it landed on a lab result.
  APPLIED
  /// Some observations landed; the rest need a human.
  PARTIAL
  /// Parsed, but nothing in it could be matched to a sample or a mapped test.
  UNMATCHED
  /// The payload could not be parsed at all.
  FAILED
  /// A human decided it must not be applied.
  DISCARDED
}

/// Whether a value was typed by a person or came off an analyzer.
enum ResultSource {
  MANUAL
  ANALYZER
}

enum ResultFlag {
  PENDING
  NORMAL
  LOW
  HIGH
  CRITICAL
  NO_RANGE
