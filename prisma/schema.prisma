generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FacilityStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

/// A tenant: one hospital, clinic or diagnostic centre that subscribes to LHIMS.
/// Every tenant-owned row carries facilityId; see src/services/tenantContext.ts.
/// Not to be confused with Hospital, which models referring hospitals.
model Facility {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  status    FacilityStatus @default(ACTIVE)
  phone     String?
  email     String?
  address   String?
  timezone  String         @default("Africa/Accra")
  currency  String         @default("GHS")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  modules                   FacilityModule[]
  sequences                 FacilitySequence[]
  facilityRoles             FacilityRole[]
  users                     User[]
  hospitals                 Hospital[]
  doctorProfiles            DoctorProfile[]
  patients                  Patient[]
  patientContacts           PatientContact[]
  patientInsurances         PatientInsurance[]
  patientDuplicateFlags     PatientDuplicateFlag[]
  departments               Department[]
  equipments                Equipment[]
  catalogItems              CatalogItem[]
  referenceParameters       ReferenceParameter[]
  referenceRanges           ReferenceRange[]
  orders                    Order[]
  orderItems                OrderItem[]
  orderStatusHistorys       OrderStatusHistory[]
  orderCancellations        OrderCancellation[]
  appointments              Appointment[]
  patientVisits             PatientVisit[]
  labSamples                LabSample[]
  labResults                LabResult[]
  labResultParameters       LabResultParameter[]
  labResultReviews          LabResultReview[]
  labResultAmendments       LabResultAmendment[]
  sampleRejections          SampleRejection[]
  qualityControlRuns        QualityControlRun[]
  inventoryItems            InventoryItem[]
  inventoryTransactions     InventoryTransaction[]
  scanAcceptances           ScanAcceptance[]
  scanBookings              ScanBooking[]
  scanResults               ScanResult[]
  scanResultFiles           ScanResultFile[]
  scanReviews               ScanReview[]
  scanRetakes               ScanRetake[]
  invoices                  Invoice[]
  invoiceItems              InvoiceItem[]
  payments                  Payment[]
  cashierShifts             CashierShift[]
  floatTransactions         FloatTransaction[]
  expenses                  Expense[]
  expensePayments           ExpensePayment[]
  ledgerEntrys              LedgerEntry[]
  receipts                  Receipt[]
  reports                   Report[]
  notifications             Notification[]
  deliveryLogs              DeliveryLog[]
  secureResultLinks         SecureResultLink[]
  auditLogs                 AuditLog[]
  systemEvents              SystemEvent[]
  apiRequestLogs            ApiRequestLog[]
  encounters                Encounter[]
  vitalSigns                VitalSigns[]
  clinicalNotes             ClinicalNote[]
  diagnoses                 Diagnosis[]
  patientAllergies          PatientAllergy[]
  prescriptions             Prescription[]
  prescriptionItems         PrescriptionItem[]
  drugs                     Drug[]
  drugBatches               DrugBatch[]
  stockMovements            StockMovement[]
  dispensations             Dispensation[]
  dispensationItems         DispensationItem[]
  wards                     Ward[]
  beds                      Bed[]
  admissions                Admission[]
  bedAssignments            BedAssignment[]
  medicationAdministrations MedicationAdministration[]

  @@index([status])
}

enum UserRole {
  PLATFORM_ADMIN
  ADMIN
  DOCTOR
  RECEPTIONIST
  LAB_STAFF
  SCAN_STAFF
  BILLING_STAFF
  NURSE
  PHARMACIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DepartmentType {
  LABORATORY
  IMAGING
  RECEPTION
  BILLING_FINANCE
  ADMIN
}

enum CatalogItemType {
  LAB
  SCAN
  /// Consultation fees and procedures billed through an encounter.
  SERVICE
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum GenderRule {
  ALL
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  SUBMITTED
  CONFIRMED
  IN_PROGRESS
  PENDING_REVIEW
  FINAL_RELEASED
  CANCELLED
}

enum OrderUrgency {
  ROUTINE
  URGENT
  CRITICAL
}

enum OrderItemStatus {
  REQUESTED
  ACCEPTED
  DRAFT
  PENDING_REVIEW
  SIGNED_OFF
  FINAL_RELEASED
  REJECTED
  RETEST_REQUESTED
  CANCELLED
}

enum LabSampleStatus {
  NOT_ACCEPTED
  ACCEPTED
  DRAFT
  PENDING_REVIEW
  SIGNED_OFF
  REJECTED
  RECOLLECTION_REQUESTED
}

enum LabResultStatus {
  DRAFT
  PENDING_REVIEW
  SIGNED_OFF
  AMENDED
  CANCELLED
}

enum ResultFlag {
  PENDING
  NORMAL
  LOW
  HIGH
  CRITICAL
  NO_RANGE
}

enum ScanStatus {
  NOT_ACCEPTED
  ACCEPTED
  DRAFT
  PENDING_REVIEW
  SIGNED_OFF
  REJECTED
  RETAKE_REQUESTED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  INSURANCE_PENDING
  REFUNDED
  WRITTEN_OFF
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  INSURANCE
  OTHER
}

enum ShiftStatus {
  OPEN
  CLOSED
  VOIDED
}

enum FloatTransactionType {
  MONEY_IN
  MONEY_OUT
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum ExpenseStatus {
  UNPAID
  PARTIAL
  PAID
  WRITTEN_OFF
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum ReportStatus {
  GENERATED
  DOWNLOADED
  VOIDED
}

enum DeliveryChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PRINT
  PDF_DOWNLOAD
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RETRIED
  CANCELLED
}

enum NotificationType {
  RESULT_RELEASED
  ORDER_UPDATE
  PAYMENT_UPDATE
  SYSTEM_ALERT
  DELIVERY_EVENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitStatus {
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  facilityId   String?
  name         String
  username     String
  email        String?
  passwordHash String
  /// Base workspace role: drives route gates and the landing page. When
  /// customRoleId is set it always equals that custom role's baseRole.
  role         UserRole
  /// Optional facility-defined role whose permission list replaces the base role's defaults.
  customRoleId String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customRole          FacilityRole?        @relation(fields: [customRoleId], references: [id])
  doctorProfile       DoctorProfile?
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]

  createdPatients    Patient[]            @relation("PatientCreatedBy")
  updatedPatients    Patient[]            @relation("PatientUpdatedBy")
  createdOrders      Order[]              @relation("OrderCreatedBy")
  confirmedOrders    Order[]              @relation("OrderConfirmedBy")
  orderStatusHistory OrderStatusHistory[] @relation("OrderStatusActor")
  cancelledOrders    OrderCancellation[]  @relation("OrderCancellationBy")

  acceptedLabSamples    LabSample[]            @relation("LabSampleAcceptedBy")
  enteredLabResults     LabResult[]            @relation("LabResultEnteredBy")
  labReviews            LabResultReview[]      @relation("LabResultReviewedBy")
  labAmendments         LabResultAmendment[]   @relation("LabAmendmentBy")
  sampleRejections      SampleRejection[]      @relation("SampleRejectedBy")
  qcRuns                QualityControlRun[]    @relation("QCPerformedBy")
  inventoryTransactions InventoryTransaction[] @relation("InventoryPerformedBy")

  scanAcceptances ScanAcceptance[] @relation("ScanAcceptedBy")
  scanBookings    ScanBooking[]    @relation("ScanBookingCreatedBy")
  scanResults     ScanResult[]     @relation("ScanResultReportedBy")
  scanReviews     ScanReview[]     @relation("ScanReviewedBy")
  scanRetakes     ScanRetake[]     @relation("ScanRetakeRequestedBy")

  createdInvoices   Invoice[]          @relation("InvoiceCreatedBy")
  receivedPayments  Payment[]          @relation("PaymentReceivedBy")
  cashierShifts     CashierShift[]     @relation("CashierShiftUser")
  floatTransactions FloatTransaction[] @relation("FloatTransactionUser")
  createdExpenses   Expense[]          @relation("ExpenseCreatedBy")
  expensePayments   ExpensePayment[]   @relation("ExpensePaymentBy")
  ledgerEntries     LedgerEntry[]      @relation("LedgerEntryUser")

  generatedReports     Report[]           @relation("ReportGeneratedBy")
  createdNotifications Notification[]     @relation("NotificationCreatedBy")
  deliveryLogs         DeliveryLog[]      @relation("DeliveryPerformedBy")
  secureResultLinks    SecureResultLink[] @relation("SecureLinkCreatedBy")

  checkedInVisits PatientVisit[]  @relation("VisitCheckedInBy")
  auditLogs       AuditLog[]      @relation("AuditActor")
  systemEvents    SystemEvent[]   @relation("SystemEventActor")
  apiRequestLogs  ApiRequestLog[] @relation("ApiRequestUser")

  facility            Facility?                  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  createdEncounters   Encounter[]                @relation("EncounterCreatedBy")
  attendedEncounters  Encounter[]                @relation("EncounterAttending")
  recordedVitals      VitalSigns[]               @relation("VitalsRecordedBy")
  authoredNotes       ClinicalNote[]             @relation("NoteAuthor")
  recordedDiagnoses   Diagnosis[]                @relation("DiagnosisRecordedBy")
  recordedAllergies   PatientAllergy[]           @relation("AllergyRecordedBy")
  prescriptionsIssued Prescription[]             @relation("Prescriber")
  receivedBatches     DrugBatch[]                @relation("BatchReceivedBy")
  stockMovements      StockMovement[]            @relation("StockMovedBy")
  dispensations       Dispensation[]             @relation("DispensedBy")
  admissionsMade      Admission[]                @relation("AdmittedBy")
  admissionsAttended  Admission[]                @relation("AdmissionAttending")
  dischargesDone      Admission[]                @relation("DischargedBy")
  bedMovesMade        BedAssignment[]            @relation("BedAssignedBy")
  medicationsGiven    MedicationAdministration[] @relation("AdministeredBy")

  @@unique([facilityId, username])
  @@unique([facilityId, email])
  @@index([facilityId])
  @@index([role])
  @@index([status])
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Hospital {
  id             String   @id @default(cuid())
  facilityId     String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  name           String
  code           String
  phone          String?
  email          String?
  address        String?
  billingContact String?
  accountStatus  String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctors      DoctorProfile[]
  patients     Patient[]
  orders       Order[]
  invoices     Invoice[]
  appointments Appointment[]

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, code])
  @@index([facilityId])
  @@index([name])
  @@index([accountStatus])
}

model DoctorProfile {
  id                String   @id @default(cuid())
  facilityId        String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  userId            String   @unique
  hospitalId        String?
  title             String   @default("Dr.")
  specialty         String
  licenseNumber     String
  council           String?  @default("Medical and Dental Council")
  phone             String?
  email             String?
  status            String   @default("Active")
  notificationEmail Boolean  @default(true)
  notificationSms   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user             User          @relation(fields: [userId], references: [id])
  hospital         Hospital?     @relation(fields: [hospitalId], references: [id])
  orders           Order[]
  referredPatients Patient[]
  appointments     Appointment[]

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, licenseNumber])
  @@index([facilityId])
  @@index([hospitalId])
  @@index([specialty])
}

model Patient {
  id                     String    @id @default(cuid())
  facilityId             String    @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  patientCode            String
  firstName              String
  lastName               String
  dateOfBirth            DateTime?
  gender                 String?
  phone                  String?
  email                  String?
  address                String?
  nationalId             String?
  insuranceProvider      String?
  policyNumber           String?
  emergencyContact       String?
  allergiesAndConditions String?
  hospitalId             String?
  referringDoctorId      String?
  createdById            String?
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  hospital        Hospital?      @relation(fields: [hospitalId], references: [id])
  referringDoctor DoctorProfile? @relation(fields: [referringDoctorId], references: [id])
  createdBy       User?          @relation("PatientCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?          @relation("PatientUpdatedBy", fields: [updatedById], references: [id])

  contacts              PatientContact[]
  insuranceRecords      PatientInsurance[]
  primaryDuplicateFlags PatientDuplicateFlag[] @relation("DuplicatePrimaryPatient")
  duplicateFlags        PatientDuplicateFlag[] @relation("DuplicateDuplicatePatient")
  orders                Order[]
  labSamples            LabSample[]
  labResults            LabResult[]
  scanBookings          ScanBooking[]
  invoices              Invoice[]
  appointments          Appointment[]
  visits                PatientVisit[]
  secureLinks           SecureResultLink[]

  facility      Facility         @relation(fields: [facilityId], references: [id])
  encounters    Encounter[]
  vitalSigns    VitalSigns[]
  clinicalNotes ClinicalNote[]
  diagnoses     Diagnosis[]
  allergies     PatientAllergy[]
  prescriptions Prescription[]
  admissions    Admission[]

  @@unique([facilityId, patientCode])
  @@index([facilityId])
  @@index([firstName, lastName])
  @@index([phone])
  @@index([nationalId])
  @@index([policyNumber])
  @@index([referringDoctorId])
}

model PatientContact {
  id         String   @id @default(cuid())
  facilityId String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  patientId  String
  type       String
  value      String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@index([patientId])
  @@index([type])
}

model PatientInsurance {
  id           String   @id @default(cuid())
  facilityId   String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  patientId    String
  provider     String
  policyNumber String
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@index([patientId])
  @@index([provider])
  @@index([policyNumber])
}

model PatientDuplicateFlag {
  id                 String    @id @default(cuid())
  facilityId         String    @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  primaryPatientId   String
  duplicatePatientId String
  reason             String
  status             String    @default("Open")
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?

  primaryPatient   Patient @relation("DuplicatePrimaryPatient", fields: [primaryPatientId], references: [id])
  duplicatePatient Patient @relation("DuplicateDuplicatePatient", fields: [duplicatePatientId], references: [id])

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@index([primaryPatientId])
  @@index([duplicatePatientId])
  @@index([status])
}

model Department {
  id         String         @id @default(cuid())
  facilityId String         @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  name       String
  code       String
  type       DepartmentType
  leadName   String?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  equipment    Equipment[]
  catalogItems CatalogItem[]

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, code])
  @@index([facilityId])
  @@index([type])
}

model Equipment {
  id             String          @id @default(cuid())
  facilityId     String          @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  departmentId   String
  name           String
  room           String?
  modality       String?
  serialNumber   String?
  status         EquipmentStatus @default(AVAILABLE)
  serviceDueDate DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  department   Department    @relation(fields: [departmentId], references: [id])
  scanBookings ScanBooking[]

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, serialNumber])
  @@index([facilityId])
  @@index([departmentId])
  @@index([status])
  @@index([modality])
}

model CatalogItem {
  id                      String          @id @default(cuid())
  facilityId              String          @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  catalogCode             String
  name                    String
  type                    CatalogItemType
  departmentId            String?
  price                   Decimal         @db.Decimal(10, 2)
  expectedCompletionHours Int             @default(24)
  sampleType              String?
  modality                String?
  aliases                 String[]        @default([])
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  department   Department?          @relation(fields: [departmentId], references: [id])
  parameters   ReferenceParameter[]
  orderItems   OrderItem[]
  invoiceItems InvoiceItem[]

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, catalogCode])
  @@index([facilityId])
  @@index([type])
  @@index([name])
  @@index([isActive])
}

model ReferenceParameter {
  id            String   @id @default(cuid())
  facilityId    String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  catalogItemId String
  name          String
  unit          String?
  methodNote    String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  catalogItem      CatalogItem          @relation(fields: [catalogItemId], references: [id])
  ranges           ReferenceRange[]
  resultParameters LabResultParameter[]

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([catalogItemId, name])
  @@index([facilityId])
  @@index([catalogItemId])
}

model ReferenceRange {
  id           String     @id @default(cuid())
  facilityId   String     @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  parameterId  String
  gender       GenderRule @default(ALL)
  ageMin       Int        @default(0)
  ageMax       Int        @default(200)
  low          Decimal?   @db.Decimal(12, 4)
  high         Decimal?   @db.Decimal(12, 4)
  criticalLow  Decimal?   @db.Decimal(12, 4)
  criticalHigh Decimal?   @db.Decimal(12, 4)
  displayRange String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  parameter ReferenceParameter @relation(fields: [parameterId], references: [id])

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@index([parameterId])
  @@index([gender])
}

model Order {
  id                   String       @id @default(cuid())
  facilityId           String       @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  orderCode            String
  patientId            String
  doctorId             String?
  hospitalId           String?
  status               OrderStatus  @default(SUBMITTED)
  urgency              OrderUrgency @default(ROUTINE)
  clinicalNotes        String?
  expectedCompletionAt DateTime?
  submittedAt          DateTime     @default(now())
  confirmedAt          DateTime?
  releasedAt           DateTime?
  createdById          String?
  confirmedById        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  patient     Patient        @relation(fields: [patientId], references: [id])
  doctor      DoctorProfile? @relation(fields: [doctorId], references: [id])
  hospital    Hospital?      @relation(fields: [hospitalId], references: [id])
  createdBy   User?          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  confirmedBy User?          @relation("OrderConfirmedBy", fields: [confirmedById], references: [id])

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  cancellations OrderCancellation[]
  invoice       Invoice?
  appointments  Appointment[]
  visits        PatientVisit[]
  reports       Report[]
  notifications Notification[]

  facility    Facility   @relation(fields: [facilityId], references: [id])
  /// Set when the order was placed during a clinical encounter.
  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id])

  @@unique([facilityId, orderCode])
  @@index([facilityId])
  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([status])
  @@index([urgency])
  @@index([submittedAt])
  @@index([encounterId])
}

model OrderItem {
  id                   String          @id @default(cuid())
  facilityId           String          @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  orderId              String
  catalogItemId        String
  type                 CatalogItemType
  status               OrderItemStatus @default(REQUESTED)
  notes                String?
  expectedCompletionAt DateTime?
  acceptedAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem    CatalogItem     @relation(fields: [catalogItemId], references: [id])
  labSample      LabSample?
  labResults     LabResult[]
  scanAcceptance ScanAcceptance?
  scanBookings   ScanBooking[]
  scanResults    ScanResult[]
  invoiceItems   InvoiceItem[]

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([orderId, catalogItemId])
  @@index([facilityId])
  @@index([orderId])
  @@index([catalogItemId])
  @@index([type])
  @@index([status])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  facilityId String       @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation("OrderStatusActor", fields: [actorId], references: [id])

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@index([orderId])
  @@index([toStatus])
  @@index([createdAt])
}

model OrderCancellation {
  id            String   @id @default(cuid())
  facilityId    String   @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  orderId       String
  cancelledById String?
  reason        String
  createdAt     DateTime @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cancelledBy User? @relation("OrderCancellationBy", fields: [cancelledById], references: [id])

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@index([orderId])
  @@index([createdAt])
}

model Appointment {
  id              String            @id @default(cuid())
  facilityId      String            @default(dbgenerated("current_setting('lhims.facility_id'::text)"))
  appointmentCode String
  patientId       String
  orderId         String?
  doctorId        String?
  hospitalId      String?
  scheduledDate   DateTime
  type            String            @default("Scheduled")
  roomOrArea      String?
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient  Patient        @relation(fields: [patientId], references: [id])
  order    Order?         @relation(fields: [orderId], references: [id])
  doctor   DoctorProfile? @relation(fields: [doctorId], references: [id])
  hospital Hospital?      @relation(fields: [hospitalId], references: [id])

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, appointmentCode])
